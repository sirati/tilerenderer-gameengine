#!/usr/bin/env bash
# Cargo runner for the *-pc-windows-gnu targets: runs the binary under Wine.
#
#   CIV3R_WINE        Wine build (default: the one built for ~/winvm, else `wine`)
#   CIV3R_WINEPREFIX  prefix (default /mnt/datasets/winvm/wine-dev, created on demand)
#
# Wayland only, like the game: DISPLAY is dropped, the prefix uses
# winewayland.drv, and WAYLAND_DISPLAY is passed through (a headless one from
# tools/../~/winvm/bin/wlh works). Vulkan goes to the host's drivers through
# winevulkan, so TILE_RENDER_ADAPTER=radv still selects the AMD iGPU.
set -euo pipefail
wine_dir=${CIV3R_WINE:-$(readlink -f "$HOME/.cache/winvm/wine" 2>/dev/null || true)}
if [ -n "$wine_dir" ] && [ -x "$wine_dir/bin/wine" ]; then
  PATH=$wine_dir/bin:$PATH
fi
export WINEPREFIX=${CIV3R_WINEPREFIX:-/mnt/datasets/winvm/wine-dev}
export WINEDEBUG=${WINEDEBUG:--all}
export WINEDLLOVERRIDES="mscoree,mshtml=;${WINEDLLOVERRIDES:-}"
unset DISPLAY
# AMD iGPU only (see flake.nix).
export VK_DRIVER_FILES=${VK_DRIVER_FILES:-/run/opengl-driver/share/vulkan/icd.d/radeon_icd.x86_64.json}
export TILE_RENDER_ADAPTER=${TILE_RENDER_ADAPTER:-radv}
export __EGL_VENDOR_LIBRARY_FILENAMES=/run/opengl-driver/share/glvnd/egl_vendor.d/50_mesa.json
export DRI_PRIME=pci-0000_72_00_0
if [ ! -f "$WINEPREFIX/system.reg" ]; then
  mkdir -p "$WINEPREFIX"
  wineboot -i >/dev/null 2>&1
  wine reg add 'HKCU\Software\Wine\Drivers' /v Graphics /d wayland /f >/dev/null 2>&1
  wineserver -w
fi
# Windows-side environment variables Wine forwards from the Unix one.
exec wine "$@"
